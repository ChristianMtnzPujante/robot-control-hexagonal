<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_node</name>
  <version>0.0.1</version>
  <description>Adaptadores de PerceptionPort (shared_kernel) y perception_node: el nodo ROS2 que publica la Scene resultante en /perception/scene -- ver ROADMAP.md, Bloque 3.</description>
  <maintainer email="chris@example.com">chris</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>shared_kernel</depend>
  <depend>ros2_kit</depend>
  <depend>ament_index_python</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
