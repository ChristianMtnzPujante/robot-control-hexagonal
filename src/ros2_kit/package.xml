<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_kit</name>
  <version>0.0.1</version>
  <description>Infraestructura ROS2 compartida entre robot_node/controller_node/commander: conversión de mensajes y ciclo de vida de nodos. No es dominio -- shared_kernel sigue sin depender de esto.</description>
  <maintainer email="chris@example.com">chris</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>shared_kernel</depend>
  <depend>rcl_interfaces</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
